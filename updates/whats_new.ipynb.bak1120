      "text/plain": [
       "      Actual  Fitted  Residuals\n",
       "2011     NaN     NaN        NaN\n",
       "2012  0.0299  0.0219     0.0080\n",
       "2013  0.0261  0.0272    -0.0011\n",
       "2014  0.0300  0.0285     0.0015\n",
       "2015  0.0255  0.0380    -0.0125\n",
       "2016  0.0407  0.0439    -0.0032\n",
       "2017  0.0078  0.0286    -0.0208\n",
       "2018  0.0599  0.0528     0.0071\n",
       "2019  0.0783  0.0573     0.0209"
