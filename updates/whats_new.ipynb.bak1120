     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import pandas as pd\n",
    "from modelconstruct_estimation import Makemodel\n",
    "from modelestimator_new import Estimate_nls, plot_actual_vs_fitted\n",
    "\n",
    "npl = pd.DataFrame({\n",
    "    'Y':   [1507633, 1559222, 1632040, 1689572, 1791141, 1862357, 1870424, 2038337,\n",
    "            2193706, 2339743, 2284300, 2394818, 2529243, 2576251, 2737770],\n",
    "    'CON': [None,    1320302, 1360376, 1396402, 1438904, 1476067, 1537410, 1549515,\n",
    "            1645118, 1779022, 1842997, 1989827, 2125755, 2144255, 2187140]},\n",
    "    index=range(2010, 2025), dtype=float)\n",
    "\n",
    "ls = Estimate_nls.with_defaults(\n",
    "    smpl=(2011, 2019), input_df=npl,\n",
    "    param_names=['lambda', 'beta_shortterm', 'beta_longterm'])\n",
    "\n",
    "mcon = Makemodel(\"\"\"<stoc, fit, est=ls>\n",
    "dlog(con) = -lambda*(log(con(-1))-log(y(-1))-log(abs(beta_longterm(1))))\n",
    "            + beta_shortterm(10)*dlog(y)   st. lambda=0.3\"\"\",\n",
    "                 type_input='single', estimator_classes={'ls': ls})\n",
    "est = mcon.estimation_records[0]['estimator_object']\n",
    "est.af_df.join(est.residuals_df).round(4)       # in units of DLOG(CON)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9473f277",
   "metadata": {},
