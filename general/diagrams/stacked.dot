// The stacked chain, when the model has leaded endogenous variables.
digraph stk {
  rankdir=TB; ranksep=0.26;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f7", color="#9a9aa2",
        fontname="Arial", fontsize=10, margin="0.16,0.08"];
  edge [color="#6b6b73", arrowsize=0.7, penwidth=0.9];
  a [label="equations for all periods", fillcolor="#eef2f7"];
  b [label="derivative equations"];
  c [label="stacked sparse Jacobian"];
  d [label="sparse LU factorization"];
  e [label="Newton update for all\nvariables in all periods", fillcolor="#eaf2ea"];
  a -> b -> c -> d -> e;
}
