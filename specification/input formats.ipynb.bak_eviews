      "\u001b[36mFile \u001b[39m\u001b[32mc:\\modelflow2\\modelflow\\modelconstruct_estimation.py:604\u001b[39m, in \u001b[36meviews_to_modelflow\u001b[39m\u001b[34m(stmt, behavioral_opts)\u001b[39m\n\u001b[32m    596\u001b[39m \u001b[38;5;28;01mdef\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[34meviews_to_modelflow\u001b[39m(stmt: \u001b[38;5;28mstr\u001b[39m, behavioral_opts: \u001b[38;5;28mstr\u001b[39m = \u001b[33m'\u001b[39m\u001b[33m<>\u001b[39m\u001b[33m'\u001b[39m) -> \u001b[38;5;28mstr\u001b[39m:\n\u001b[32m    597\u001b[39m \u001b[38;5;250m    \u001b[39m\u001b[33;03m\"\"\"Translate one EViews equation to ModelFlow form.\u001b[39;00m\n\u001b[32m    598\u001b[39m \n\u001b[32m    599\u001b[39m \u001b[33;03m    ``@IDENTITY`` equations get ``<>``, all other equations get\u001b[39;00m\n\u001b[32m   (...)\u001b[39m\u001b[32m    602\u001b[39m \u001b[33;03m    (``D(`` -> ``DIFF(``, ``@PC`` -> ``PCT_GROWTH``, ``^`` -> ``**`` ...).\u001b[39;00m\n\u001b[32m    603\u001b[39m \u001b[33;03m    \"\"\"\u001b[39;00m\n\u001b[32m--> \u001b[39m\u001b[32m604\u001b[39m     \u001b[38;5;28;01mfrom\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[34;01mmodelgrabwf2\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;28;01mimport\u001b[39;00m GrabWf2Model\n\u001b[32m    606\u001b[39m     m = re.match(\u001b[33mr\u001b[39m\u001b[33m'\u001b[39m\u001b[33m\\\u001b[39m\u001b[33ms*@IDENTITY\u001b[39m\u001b[33m\\\u001b[39m\u001b[33ms+(.*)\u001b[39m\u001b[33m'\u001b[39m, stmt, flags=re.IGNORECASE | re.DOTALL)\n\u001b[32m    607\u001b[39m     opts, body = (\u001b[33m'\u001b[39m\u001b[33m<>\u001b[39m\u001b[33m'\u001b[39m, m.group(\u001b[32m1\u001b[39m)) \u001b[38;5;28;01mif\u001b[39;00m m \u001b[38;5;28;01melse\u001b[39;00m (behavioral_opts, stmt)\n",
